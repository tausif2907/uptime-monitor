{
  "name": "uptime-monitor",
  "private": true,
  "version": "0.1.0",
  "description": "Uptime monitor with public status pages \u00e2\u20ac\u201d Next.js frontend, BullMQ worker backend, PostgreSQL + Redis.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "node -e \"require('fs').existsSync('.env')||require('fs').copyFileSync('.env.example','.env')\" && pnpm install && docker compose up -d --wait && pnpm db:deploy && pnpm db:seed",
    "dev": "pnpm --parallel --filter @uptime/frontend --filter @uptime/backend dev",
    "dev:frontend": "pnpm --filter @uptime/frontend dev",
    "dev:backend": "pnpm --filter @uptime/backend dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @uptime/frontend test:e2e",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @uptime/database generate",
    "db:migrate": "pnpm --filter @uptime/database migrate:dev",
    "db:deploy": "pnpm --filter @uptime/database migrate:deploy",
    "db:seed": "pnpm --filter @uptime/database seed",
    "db:studio": "pnpm --filter @uptime/database studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.30",
      "deepmerge-ts": "^8.0.0"
    }
  }
}
