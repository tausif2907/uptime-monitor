# Copy to `.env` in the repo root: cp .env.example .env
# Every app (frontend, backend, database scripts) reads this one file locally.
# In production, set the same variables in Vercel / Railway / Render.

# --- Infrastructure ---------------------------------------------------------
DATABASE_URL="postgresql://uptime:uptime@localhost:5432/uptime?schema=public"
REDIS_URL="redis://localhost:6379"

# --- Frontend (Next.js + Auth.js) ------------------------------------------
# Public URL of the web app (used in alert emails and auth callbacks)
APP_URL="http://localhost:3000"
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_TRUST_HOST=true
# Google OAuth (optional) — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Demo login (email + password from the seed). Keep "true" for the public demo account.
DEMO_LOGIN_ENABLED=true
DEMO_EMAIL="demo@uptime.local"
DEMO_PASSWORD="demo-password"

# --- Email (Resend) — https://resend.com/api-keys ---------------------------
# Used for magic-link sign-in AND incident alerts. Leave empty locally:
# emails are then printed to the console instead of sent.
RESEND_API_KEY=""
EMAIL_FROM="Uptime Monitor <onboarding@resend.dev>"

# --- Backend (worker) -------------------------------------------------------
WORKER_CONCURRENCY=20
# Port for the worker's /health endpoint (Railway/Render inject PORT automatically)
PORT=4000
# Allow checks against localhost/private IPs. ONLY for tests and load tests.
ALLOW_PRIVATE_TARGETS=false
