# Copy to `.env` in the repo root: cp .env.example .env
# Every app (frontend, backend, database scripts) reads this one file locally.
# In production, set the same variables in Vercel / Railway / Render.

# --- Infrastructure ---------------------------------------------------------
DATABASE_URL="postgresql://uptime:uptime@localhost:5432/uptime?schema=public"
REDIS_URL="redis://localhost:6379"

# --- Frontend (Next.js + Auth.js) ------------------------------------------
# Public URL of the web app (used in alert emails and auth callbacks)
APP_URL="http://localhost:3000"
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_TRUST_HOST=true
# "Continue with Google" (optional) — see docs/DEPLOYMENT.md
#   Redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# "Continue with GitHub" (optional) — https://github.com/settings/developers → New OAuth App
#   Callback URL: <APP_URL>/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Demo login (the seeded shared account). In production DEMO_PASSWORD must NOT be
# "demo-password" or the demo button is disabled. It's only used server-side.
DEMO_LOGIN_ENABLED=true
DEMO_EMAIL="demo@uptime.local"
DEMO_PASSWORD="demo-password"
# Who can open /admin (visitors, sign-ups, usage). Comma-separated, must be verified accounts.
ADMIN_EMAILS=""
# Shown on the Help page as "Email support" (optional)
SUPPORT_EMAIL=""

# --- Email (Resend) — https://resend.com/api-keys ---------------------------
# Used for sign-up verification, password resets, magic links AND incident alerts.
# Leave empty locally: emails are printed to the console and links shown in the UI.
# Until you verify a domain in Resend, it only delivers to your own Resend account email.
RESEND_API_KEY=""
EMAIL_FROM="Uptime Monitor <onboarding@resend.dev>"

# --- Backend (worker) -------------------------------------------------------
WORKER_CONCURRENCY=20
# Port for the worker's /health endpoint (Railway/Render inject PORT automatically)
PORT=4000
# Allow checks against localhost/private IPs. ONLY for tests and load tests.
ALLOW_PRIVATE_TARGETS=false

# --- Tests only (never set in production) -----------------------------------
# Scale per-IP rate limits (every test request comes from one machine).
RATE_LIMIT_IP_MULTIPLIER=1
# Show emailed links in the UI even in a production build (CI has no email provider).
E2E_SHOW_EMAIL_LINKS=false
