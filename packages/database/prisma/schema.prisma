// Uptime Monitor — data model
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js tables (managed by @auth/prisma-adapter)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  // bcrypt hash; null for accounts that only use Google / GitHub / magic links.
  passwordHash  String?

  // Two-factor authentication (TOTP). The secret is AES-256-GCM encrypted at rest.
  totpSecret    String?
  totpEnabledAt DateTime?
  // Last accepted 30-second time step, so a code can't be replayed.
  totpLastStep  Int?
  // SHA-256 hashes of unused one-time backup codes.
  backupCodes   String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  projects Project[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain tables
// ---------------------------------------------------------------------------

model Project {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  // Drives the public status page URL: /status/<slug>
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  monitors      Monitor[]
  alertChannels AlertChannel[]

  @@index([ownerId])
}

enum HttpMethod {
  GET
  HEAD
  POST
}

enum MonitorStatus {
  PENDING
  UP
  DOWN
}

model Monitor {
  id             String     @id @default(cuid())
  projectId      String
  name           String
  url            String
  method         HttpMethod @default(GET)
  intervalSec    Int        @default(60)
  timeoutMs      Int        @default(10000)
  expectedStatus Int        @default(200)
  isPaused       Boolean    @default(false)

  // Denormalised for fast dashboards; written by the worker after every check.
  status              MonitorStatus @default(PENDING)
  consecutiveFailures Int           @default(0)
  lastCheckedAt       DateTime?
  lastResponseTimeMs  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checkResults CheckResult[]
  dailyStats   DailyStat[]
  incidents    Incident[]

  @@index([projectId])
}

// The only fast-growing table: raw rows are kept 30 days, then live on in DailyStat.
model CheckResult {
  id             String   @id @default(cuid())
  monitorId      String
  checkedAt      DateTime @default(now())
  ok             Boolean
  statusCode     Int?
  responseTimeMs Int?
  error          String?

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt(sort: Desc)])
  @@index([checkedAt])
}

// Nightly rollup: powers 7d/30d uptime and the 90-day bars without scanning raw checks.
model DailyStat {
  monitorId   String
  date        DateTime @db.Date
  totalChecks Int
  okChecks    Int
  avgMs       Int?
  p95Ms       Int?

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@id([monitorId, date])
}

// At most one open incident per monitor: enforced by a partial unique index
// ("Incident_one_open_per_monitor", WHERE "resolvedAt" IS NULL) in the init migration.
model Incident {
  id         String    @id @default(cuid())
  monitorId  String
  startedAt  DateTime  @default(now())
  resolvedAt DateTime?
  cause      String?

  monitor       Monitor        @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([monitorId, startedAt(sort: Desc)])
}

enum AlertChannelType {
  EMAIL
  WEBHOOK
}

model AlertChannel {
  id        String           @id @default(cuid())
  projectId String
  type      AlertChannelType
  // Email address or webhook URL
  target    String
  // Webhooks only: HMAC-SHA256 key used to sign each request (X-Uptime-Signature header).
  secret    String?
  isEnabled Boolean          @default(true)
  createdAt DateTime         @default(now())

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([projectId])
}

enum NotificationEvent {
  OPENED
  RESOLVED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// Unique (incidentId, channelId, event) + insert-before-send = an alert is never sent twice.
model Notification {
  id         String             @id @default(cuid())
  incidentId String
  channelId  String
  event      NotificationEvent
  status     NotificationStatus @default(PENDING)
  error      String?
  sentAt     DateTime?
  createdAt  DateTime           @default(now())

  incident Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  channel  AlertChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([incidentId, channelId, event])
}
